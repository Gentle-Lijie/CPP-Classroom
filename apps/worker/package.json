{
  "name": "@classroom/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "tsx src/probe.ts",
    "runtime:probe": "tsx src/runtime-probe.ts"
  },
  "dependencies": {
    "@classroom/config": "workspace:*",
    "@classroom/contracts": "workspace:*",
    "@classroom/database": "workspace:*",
    "pg-boss": "12.38.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsx": "4.23.15"
  }
}
