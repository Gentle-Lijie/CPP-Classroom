+func streamOutput(ctx context.Context, outCh chan *OutputResponse, so *fileStreamOut) error {
+    var emitted int64
+    var buf []byte
+    for {
+        select { case <-ctx.Done(): return nil; default: }
+        if len(buf) < minBuffLen { buf = make([]byte,newBuffLen) }
+        n,err := so.Read(buf)
+        limitHit := false
+        if so.max > 0 && emitted+int64(n) > so.max {
+            n = int(so.max-emitted)
+            limitHit = true
+        }
+        if n > 0 {
+            select {
+            case <-ctx.Done(): return nil
+            case outCh <- &OutputResponse{Index:so.index,Fd:so.fd,Content:buf[:n]}:
+            }
+            emitted += int64(n)
+            buf = buf[n:]
+        }
+        if limitHit { return &streamOutputLimitError{index:so.index} }
+        if err != nil { return nil }
+    }
 }
diff --git a/cmd/go-judge/stream/stream_test.go b/cmd/go-judge/stream/stream_test.go
index 95977c7..0c8baad 100644
--- a/cmd/go-judge/stream/stream_test.go
+++ b/cmd/go-judge/stream/stream_test.go
@@ -2,6 +2,7 @@ package stream
 
 import (
 	"context"
+"io"
 	"sync"
 	"testing"
 
@@ -62,3 +63,31 @@ func TestSendLoopDrainsOutputBeforeFinalResponse(t *testing.T) {
 		t.Fatalf("expected final response second, got %#v", s.sends[1])
 	}
 }
+
+type eofInputStream struct { requests []*Request }
+func (s *eofInputStream) Send(Response) error { return nil }
+func (s *eofInputStream) Recv() (*Request,error) {
+ if len(s.requests)==0 { return nil,io.EOF }
+ r:=s.requests[0];s.requests=s.requests[1:];return r,nil
+}
+func TestCloseInputDoesNotCancelExecutionAndCleanupIsIdempotent(t *testing.T) {
+ f:=newFileStreamIn(0,0,false)
+ cancelled:=false
+ s:=&eofInputStream{requests:[]*Request{{CloseInput:&InputRequest{Index:0,Fd:0}}}}
+ if err:=streamInput(context.Background(),s,[]*fileStreamIn{f},func(){cancelled=true});err!=nil {t.Fatal(err)}
+ if cancelled {t.Fatal("EOF cancelled execution")}
+ if _,err:=f.Write([]byte("after EOF"));err!=io.EOF {t.Fatalf("stdin still open: %v",err)}
+ if err:=f.Close();err!=nil {t.Fatalf("second close failed: %v",err)}
+}
+
+func TestOutputLimitIsReportedAfterBufferedOutput(t *testing.T) {
+ s:=&recordingStream{}
+ out:=make(chan *OutputResponse,1)
+ out<-&OutputResponse{Index:0,Fd:1,Content:[]byte("bounded")};close(out)
+ done:=make(chan error,1);done<-&streamOutputLimitError{index:0};close(done)
+ results:=make(chan worker.Response,1)
+ results<-worker.Response{Results:[]worker.Result{{Status:envexec.StatusSignalled}}}
+ if err:=sendLoop(context.Background(),s,out,done,results,zap.NewNop());err!=nil {t.Fatal(err)}
+ if len(s.sends)!=2 || s.sends[0].Output==nil {t.Fatal("buffered output not drained")}
+ if s.sends[1].Response.Results[0].Status.String()!="Output Limit Exceeded" {t.Fatal("output limit misclassified")}
+}
