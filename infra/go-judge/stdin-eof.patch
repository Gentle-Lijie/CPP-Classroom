diff --git a/cmd/go-judge/stream/stream_test.go b/cmd/go-judge/stream/stream_test.go
index 95977c7..3a124de 100644
--- a/cmd/go-judge/stream/stream_test.go
+++ b/cmd/go-judge/stream/stream_test.go
@@ -2,6 +2,7 @@ package stream
 
 import (
 	"context"
+"io"
 	"sync"
 	"testing"
 
@@ -62,3 +63,19 @@ func TestSendLoopDrainsOutputBeforeFinalResponse(t *testing.T) {
 		t.Fatalf("expected final response second, got %#v", s.sends[1])
 	}
 }
+
+type eofInputStream struct { requests []*Request }
+func (s *eofInputStream) Send(Response) error { return nil }
+func (s *eofInputStream) Recv() (*Request,error) {
+ if len(s.requests)==0 { return nil,io.EOF }
+ r:=s.requests[0];s.requests=s.requests[1:];return r,nil
+}
+func TestCloseInputDoesNotCancelExecutionAndCleanupIsIdempotent(t *testing.T) {
+ f:=newFileStreamIn(0,0,false)
+ cancelled:=false
+ s:=&eofInputStream{requests:[]*Request{{CloseInput:&InputRequest{Index:0,Fd:0}}}}
+ if err:=streamInput(context.Background(),s,[]*fileStreamIn{f},func(){cancelled=true});err!=nil {t.Fatal(err)}
+ if cancelled {t.Fatal("EOF cancelled execution")}
+ if _,err:=f.Write([]byte("after EOF"));err!=io.EOF {t.Fatalf("stdin still open: %v",err)}
+ if err:=f.Close();err!=nil {t.Fatalf("second close failed: %v",err)}
+}
