NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
VITE_API_TARGET=http://127.0.0.1:3000
DATABASE_URL=postgresql://classroom:replace-this-local-password@127.0.0.1:55432/classroom

# 原生 PostgreSQL 工具目录；留空时自动查找 PATH、Homebrew 或 Postgres.app。
POSTGRES_BIN_DIR=

# 原生 Linux go-judge 的内网地址。未配置时 API 仍可启动，页面明确显示未配置。
GO_JUDGE_URL=
GO_JUDGE_AUTH_TOKEN=
GO_JUDGE_TIMEOUT_MS=2000

# 可选：业务进程通过原生 SSH 隧道连接 Linux 评测节点。
RUNNER_SSH_HOST=aim-radar
RUNNER_LOCAL_PORT=15050
RUNNER_REMOTE_ADDRESS=127.0.0.1
