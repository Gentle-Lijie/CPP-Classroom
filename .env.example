NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
VITE_API_TARGET=http://127.0.0.1:3000
DATABASE_URL=postgresql://classroom:replace-this-local-password@127.0.0.1:5432/classroom

# 原生 Linux go-judge 的 HTTPS 入口，支持 HTTP API 与 WebSocket 流协议。
GO_JUDGE_URL=https://go-judge.unnc.space
GO_JUDGE_AUTH_TOKEN=
GO_JUDGE_TIMEOUT_MS=10000
# 可选：此 worker 的最大并发；不设置则跟随平台全局上限。
# WORKER_CONCURRENCY=4
