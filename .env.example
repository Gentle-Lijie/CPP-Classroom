NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=5173
VITE_API_TARGET=http://127.0.0.1:3000
DATABASE_URL=postgresql://classroom:replace-this-local-password@127.0.0.1:55432/classroom

# 原生 PostgreSQL 工具目录；留空时自动查找 PATH、Homebrew 或 Postgres.app。
POSTGRES_BIN_DIR=

# 原生 Linux go-judge 的 HTTPS 入口，支持 HTTP API 与 WebSocket 流协议。
GO_JUDGE_URL=https://go-judge.unnc.space
GO_JUDGE_AUTH_TOKEN=
GO_JUDGE_TIMEOUT_MS=10000
